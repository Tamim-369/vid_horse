# Copy to .env and fill in as needed.

# Which LLM backend to use: "ollama" (local) or "groq" (hosted).
VIDEOAI_LLM_PROVIDER=ollama

# Ollama (local models)
VIDEOAI_OLLAMA_HOST=http://localhost:11434
VIDEOAI_OLLAMA_MODEL=gemma3:4b
VIDEOAI_OLLAMA_NUM_CTX=4096
VIDEOAI_OLLAMA_TEMPERATURE=0.7
# VIDEOAI_OLLAMA_NUM_PREDICT=
VIDEOAI_OLLAMA_KEEP_ALIVE=5m
VIDEOAI_OLLAMA_TIMEOUT=600

# Groq (hosted models)
# Two key modes:
#   single -> uses only GROQ_API_KEY
#   pool   -> rotates through GROQ_API_KEY_FIRST/_SECOND/_THIRD/_FOURTH,
#             falling back to GROQ_API_KEY; a failed key rolls to the next.
VIDEOAI_GROQ_KEY_MODE=pool
VIDEOAI_GROQ_MODEL=openai/gpt-oss-120b
VIDEOAI_GROQ_BASE_URL=https://api.groq.com/openai/v1
VIDEOAI_GROQ_TEMPERATURE=0.7
# VIDEOAI_GROQ_MAX_TOKENS=
VIDEOAI_GROQ_TIMEOUT=120
# Single-key mode:
GROQ_API_KEY=
# Pool mode (any subset works, tried in this order):
GROQ_API_KEY_FIRST=
GROQ_API_KEY_SECOND=
GROQ_API_KEY_THIRD=
GROQ_API_KEY_FOURTH=

# Image sources / services
PIXELS_API_KEY=
HF_TOKEN=

# Voice / narration delivery
# Reference voice clip used for cloning (8.5s clean slice)
# VIDEOAI_VOICE_PROMPT=assets/voice/voice_prompt_short.wav
# Expressiveness: 0 = flat newsreader, ~0.4 = dramatic storyteller. Tune in 0.1 steps.
VIDEOAI_VOICE_EXAGGERATION=0.4
VIDEOAI_VOICE_CFG_WEIGHT=0.4
# Silence between sentences within a line, and between script lines (seconds)
VIDEOAI_VOICE_SENTENCE_GAP=0.24
VIDEOAI_VOICE_LINE_GAP=0.35

# Vision quality gates / subtitles
VIDEOAI_VISION_MODEL=qwen3-vl:2b
VIDEOAI_VISION_DECISION_MODEL=d3:2b
VIDEOAI_SUBTITLE_WHISPER_MODEL=base.en

# Reliability
VIDEOAI_MAX_RETRIES=2

# Caching / output
VIDEOAI_CACHE_ENABLED=true
VIDEOAI_CACHE_DIR=.cache/videoai
VIDEOAI_OUTPUT_DIR=output
VIDEOAI_LOG_LEVEL=INFO

# YouTube publishing (optional)
YOUTUBE_PRIVACY_STATUS=private
YOUTUBE_REDIRECT_PORT=8080
YOUTUBE_CATEGORY_ID=22
AUTO_PUBLISH=false
