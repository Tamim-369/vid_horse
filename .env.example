# Copy to .env and fill in as needed.

# Language model
VIDEOAI_LLM_PROVIDER=openai
VIDEOAI_LLM_MODEL=gpt-4o-mini
VIDEOAI_LLM_API_KEY=
# Optional: point at OpenRouter, Groq, Ollama (http://localhost:11434/v1), etc.
# VIDEOAI_LLM_BASE_URL=
VIDEOAI_LLM_TEMPERATURE=0.7
# VIDEOAI_LLM_MAX_TOKENS=

# Optional web search grounding
VIDEOAI_SEARCH_PROVIDER=none
VIDEOAI_SEARCH_API_KEY=
VIDEOAI_SEARCH_MAX_RESULTS=5

# Output / logging
VIDEOAI_OUTPUT_DIR=output
VIDEOAI_LOG_LEVEL=INFO
